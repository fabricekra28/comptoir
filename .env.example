# Copiez ce fichier en « .env » puis remplacez les trois secrets.
# Pour en générer un :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
INTERNAL_TOKEN=remplacez-moi-par-une-autre-chaine-aleatoire
# Lettres et chiffres uniquement (il est inséré tel quel dans une adresse de connexion)
POSTGRES_PASSWORD=remplacezmoiaussi

# Premier administrateur, créé au premier démarrage (mot de passe modifiable ensuite dans « Mon compte »)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Boutique
APP_NAME=Comptoir
CURRENCY=€
CURRENCY_DECIMALS=2
APP_TIMEZONE=UTC
# « true » remplit le catalogue de 12 produits d'exemple s'il est vide
SEED_DEMO=true
# « true » dès que le site est servi en HTTPS (obligatoire en production)
COOKIE_SECURE=false
GATEWAY_PORT=8000
